# ====================
# Application Settings
# ====================
APP_NAME=EnglishWebAI
APP_VERSION=1.0.0
DEBUG=False
API_PREFIX=/api/v1

# ====================
# Server Configuration
# ====================
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=80

# ====================
# Database (PostgreSQL)
# ====================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=englishwebai_user
POSTGRES_PASSWORD=englishwebai_password
POSTGRES_DB=englishwebai_db

# ====================
# Security
# ====================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# SMTP Email Configuration
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@englishwebai.com
SMTP_FROM_NAME=EnglishWebAI

# ====================
# OTP Configuration
# ====================
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

# ====================
# AI Configuration - OpenAI
# ====================
# Get an API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-nano

AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# ====================
# CORS Settings
# ====================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
ALLOWED_HEADERS=*

# ====================
# Frontend Configuration
# ====================
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ====================
# AWS S3 (Optional)
# ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
